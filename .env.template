# .env.template
# 이 파일을 복사해서 .env로 만들고 실제 값을 입력하세요
# cp .env.template .env

# ============================================
# 네이버 API 키 (선택사항)
# ============================================
# 네이버 데이터랩 API를 사용하려면 아래 키를 입력하세요
# https://developers.naver.com/에서 발급 가능
# 입력하지 않으면 대안 방법(검색 결과 수 기반 추정)을 사용합니다

NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

